# Copy to .env.local and fill in. NEVER commit real secrets.
# M0 note: the app typechecks, builds, and boots WITHOUT these set.
# Anything that needs the database or auth will fail with a clear
# "missing env" message instead of a cryptic crash.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for Prisma (Supabase: Settings → Database).
# Use the pooled connection string (port 6543) for serverless, or the direct
# one (port 5432) for `prisma db push` / seed.
DATABASE_URL=
