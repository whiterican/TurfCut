# Copy to .env.local and fill in. NEVER commit real secrets.
# M0 note: the app typechecks, builds, and boots WITHOUT these set.
# Anything that needs the database or auth will fail with a clear
# "missing env" message instead of a cryptic crash.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (or the legacy anon key) — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret key (or the legacy service_role key) — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection strings (Supabase: Project → Connect).
# DATABASE_URL: what the running app uses. On Vercel this MUST be the
#   pooler in transaction mode (port 6543), or serverless instances exhaust
#   max_connections. pgbouncer=true and connection_limit=1 are added if missing.
# DIRECT_URL: the direct connection (port 5432), used only by the Prisma CLI
#   (`npm run db:push`) and other one-off scripts. Never needed at runtime.
# Locally, set both to the same local Postgres URL.
DATABASE_URL=
DIRECT_URL=
# Public origin of this deployment, e.g. https://app.turfcut.com — used for
# sign-in and confirmation links. Required in production; local dev falls
# back to http://localhost:3000. Add <SITE_URL>/auth/confirm to Supabase →
# Authentication → URL Configuration → Redirect URLs.
SITE_URL=

# Stripe (M5 payouts) — SERVER ONLY. Test mode keys (sk_test_…) until the
# pilot. Without STRIPE_SECRET_KEY the app tracks and approves pay but
# can't send it. Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <SITE_URL>/api/stripe/webhook
# (events: transfer.created, transfer.reversed). Stripe Dashboard →
# Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Optional: a second endpoint (same URL) listening to CONNECTED ACCOUNTS for
# account.updated, so a worker's payout status updates without a page visit.
# The app also re-checks with Stripe before every payment.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Error reporting (optional). Leave empty to run without Sentry.
# Server DSN (SERVER ONLY) and browser DSN (safe to expose) from the Sentry
# project's settings. Only errors are sent: no request bodies, cookies or ids.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Rate limits need to know the client's address, and no header is trusted
# until you name one. Set EXACTLY ONE:
# - CLIENT_IP_HEADER: a header your platform sets itself, e.g.
#   x-vercel-forwarded-for (Vercel), cf-connecting-ip (Cloudflare),
#   fly-client-ip (Fly).
# - TRUSTED_PROXY_HOPS: behind your own nginx/HAProxy, the number of proxies
#   in front of the app, so x-forwarded-for is read from the trusted end.
# With neither set, per-connection limits are skipped (per-email and
# per-worker limits still apply).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
