// Turfcut — M0 Prisma schema.
// Distilled from the Turfcut MVP Spec data model (p.17) and the build plan.
//
// INVARIANTS (see CLAUDE.md — non-negotiable):
// - work_events, validations, payouts, audit_events are APPEND-ONLY.
//   Never UPDATE or DELETE rows. Corrections are new events that supersede.
// - profile_metrics stores versioned aggregates derived from work_events.
// - Jurisdiction hard stop: a job cannot publish unless its jurisdiction
//   profile is approved and current (enforced in application code, M2).
// - political_preferences: consent versioning — a preference change writes a
//   NEW row with an incremented consentVersion. Employers only ever see
//   worker-authorized overlap.

generator client {
  provider = "prisma-client-js"
}

// Two connections (Supabase):
// - DATABASE_URL: what the app uses at runtime. On Vercel, the pooler in
//   transaction mode, port 6543 (src/lib/env.ts adds pgbouncer=true and
//   connection_limit=3 when missing).
// - DIRECT_URL: the direct connection, port 5432, used by the Prisma CLI
//   (db push, migrate) which needs a session the pooler can't give.
// Locally both can be the same URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / roles
// ---------------------------------------------------------------------------

enum Role {
  WORKER // field worker (1099 contractor)
  OWNER // organization owner
  RECRUITER // organization recruiter seat
  COMPLIANCE // organization compliance reviewer
  SUPERVISOR // field supervisor (reviews work)
  FINANCE // organization finance (payouts, exports)
  PUBLISHER // C1: campaign communications (campaign profiles and feed land in C6)
  CUSTOM // M10.6: an organization-defined role; what it reaches is its OrgRole's grants (Profile.orgRoleId)
}

/// How far a role's grant on an area goes (M10.6): the access map's full or read.
enum RoleAccessLevel {
  FULL
  READ
}

/// Links a Supabase Auth user to a Turfcut role.
/// M0: one role per user. C1: owners add members through OrgInvite; removing a
/// member detaches them (orgId = null) and keeps their login and history. Worker users get a workers row; company users get an
/// organizations row and one of the org roles.
model Profile {
  id              String        @id @db.Uuid // == Supabase auth.users.id
  role            Role
  worker          Worker?
  orgId           String?       @db.Uuid
  org             Organization? @relation(fields: [orgId], references: [id])
  /// M10.6: set exactly when role is CUSTOM (a CHECK keeps the two in step).
  orgRoleId       String?       @db.Uuid
  orgRole         OrgRole?      @relation("OrgRoleMembers", fields: [orgRoleId], references: [id], onDelete: Restrict)
  orgRolesCreated OrgRole[]     @relation("OrgRoleCreator")
  // Org staff's name as shown in chat ("Maya Chen · Manager"). Workers use
  // Worker.displayName. Never shown to anyone outside a shared conversation.
  displayName     String?
  // Account closure (M7): set when the person closed their account. The
  // auth user is deleted; this row and everything it anchors stay (rule 3).
  closedAt        DateTime?
  // Turfcut staff (M10): when this account was made staff; null for everyone
  // else. Independent of role (a staff member can also be a worker or an
  // owner). Set by hand in SQL, never by the app (README, "Turfcut staff").
  staffSince      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hiredEngagements      Engagement[]              @relation("HiredBy")
  notifications         Notification[]
  chatParticipations    ConversationParticipant[]
  sentMessages          Message[]
  blocksMade            ProfileBlock[]            @relation("Blocker")
  blocksReceived        ProfileBlock[]            @relation("Blocked")
  campaignPosts         CampaignPost[]            @relation("CampaignPostAuthor")
  deletedCampaignPosts  CampaignPost[]            @relation("CampaignPostDeleter")
  campaignPostRevisions CampaignPostRevision[]
  talkingPointFacts     TalkingPointFact[]        @relation("TalkingPointFactAuthor")
  campaignResources     CampaignResource[]        @relation("CampaignResourceAuthor")
  slotsPosted           ShiftSlot[]               @relation("ShiftSlotCreator")
  disputeMessages       PayDisputeMessage[]       @relation("DisputeMessageAuthor")
  slotsSupervised       ShiftSlot[]               @relation("ShiftSlotSupervisor")
  adminActions          AdminAction[]             @relation("AdminActionStaff")
  campaignsVerified     CampaignProfile[]         @relation("CampaignVerifier")

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Workers
// ---------------------------------------------------------------------------

enum VerificationLevel {
  PLATFORM // verified by Turfcut
  ORGANIZATION // verified by a hiring organization
  IMPORTED // imported from a trusted external source
  SELF_REPORTED // worker-entered; visible but excluded from verified totals
}

/// C3.6: how a verified credential was checked. A proof photo is evidence a
/// person looked at, never verification by itself.
enum VerificationMethod {
  REGISTRY_LOOKUP // checked the issuing state's registry
  ORIGINAL_DOCUMENT // saw the original document
  PROOF_PHOTO // looked at the worker's proof photo (C3.6b)
}

enum ProofSide {
  FRONT
  BACK
}

enum ProofDeletionReason {
  WORKER_REMOVED // the worker took it down
  CREDENTIAL_REMOVED // the credential it supports was removed
  NO_LONGER_ELIGIBLE // an edit made the credential one that takes no photo
  LAPSED // a year after the training date (the Colorado registration it supports)
  ACCOUNT_CLOSED
}

model Worker {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @unique @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  displayName String
  phone       String?
  // Account closure (M7): name and phone are anonymized; history stays.
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  experience       ExperienceRecord[]
  preferences      PoliticalPreference[]
  engagements      Engagement[]
  metrics          ProfileMetric[]
  payouts          Payout[]
  sharing          WorkerSharing[]
  availabilities   WorkerAvailability[]
  credentials      WorkerCredential[]
  credentialProofs CredentialProof[]
  mutes            OrgMute[]

  // Payouts (M5): the worker's Stripe Connect account. Bank and tax details
  // stay with Stripe; payoutsEnabled caches whether Stripe can pay them.
  stripeAccountId  String?   @unique
  payoutsEnabled   Boolean   @default(false)
  payoutsCheckedAt DateTime?

  payoutTransfers PayoutTransfer[]
  payDisputes     PayDispute[]

  // S2: the worker's own social activity. Private to the worker; never read
  // by matching, scorecards or any ranking (C1-Q14).
  campaignFollows CampaignFollow[]
  postLikes       PostLike[]
}

/// One past campaign on a worker's profile. The verification level travels
/// with the record. Workers can only create SELF_REPORTED rows; PLATFORM,
/// ORGANIZATION and IMPORTED are set by Turfcut, a hiring org, or an import —
/// never by the worker. SELF_REPORTED rows are visible but excluded from
/// verified totals.
model ExperienceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  workerId          String            @db.Uuid
  worker            Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  // Spec p.9 "Fields on every experience record". Option lists for the
  // String fields are defined and validated in src/lib/experience.ts.
  // Campaign: organization, project (= campaign), type, role, channel
  organizationName  String?
  campaign          String
  campaignType      String? // e.g. "ballot_initiative", "candidate"
  experienceGroup   String? // e.g. "petition_circulation", "door_to_door"
  role              String
  channel           String? // e.g. "door", "public_intercept", "phone"
  // Where
  state             String?           @db.VarChar(2)
  countyOrDistrict  String?
  turfType          String? // "urban" | "suburban" | "rural"
  // When
  startDate         DateTime          @db.Date
  endDate           DateTime?         @db.Date // null = ongoing
  completedShifts   Int?
  activeHours       Float?
  // What: submitted output (unitCount) and approved output
  unitType          String // e.g. "signatures", "doors"
  unitCount         Int
  approvedCount     Int?
  // Proof
  referenceContact  String? // never shown to employers
  verificationLevel VerificationLevel @default(SELF_REPORTED)
  verifiedById      String?           @db.Uuid // Profile.id of the verifier
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([workerId])
}

/// Worker-controlled political-fit signals. NEVER inferred — every value here
/// is explicitly self-reported by the worker (spec: "worker-controlled, never
/// inferred"). Consent versioning: edits append a new row; the latest
/// consentVersion is authoritative.
enum VisibilityMode {
  PRIVATE // never shown to any employer
  MATCHING_ONLY // usable for matching, shown as "not shared"
  APPLIED_TO // visible to orgs the worker applied to / was invited by
  APPROVED_RECRUITERS // visible to recruiters the worker explicitly approved
}

model PoliticalPreference {
  id                 String         @id @default(uuid()) @db.Uuid
  workerId           String         @db.Uuid
  // Consent history outlives nothing: a worker with versions can't be deleted (owner decision; rule 3).
  worker             Worker         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  visibilityMode     VisibilityMode
  // JSON shapes are defined and validated in src/lib/political-fit.ts.
  // Each answer carries its own opt-in `shared` flag.
  identityLabels     Json? // e.g. [{"label": "independent", "shared": true}, {"label": "other", "text": "..."}]
  partyRelationship  Json? // e.g. {"relationship": "leans_toward", "party": "democratic"} — NOT voter registration
  issuePositions     Json? // e.g. {"housing_affordability": {"position": "lean_support", "importance": "high"}}
  campaignBoundaries Json? // e.g. [{"kind": "campaign_type", "target": "candidate", "stance": "ask_me_first"}]
  consentVersion     Int            @default(1)
  // Worker-chosen expiry (null = no expiry). After it passes — or when the
  // consent wording changes (consentTextVersion differs from the current
  // one) — answers are treated as not shared until the worker reconfirms,
  // which writes a new version.
  expiresAt          DateTime?
  consentTextVersion String? // null on rows written before consent wording was versioned
  createdAt          DateTime       @default(now())

  // Unique so two concurrent saves can't both claim version N+1.
  @@unique([workerId, consentVersion])
}

// ---------------------------------------------------------------------------
// Organizations & jurisdiction
// ---------------------------------------------------------------------------

model Organization {
  id                       String            @id @default(uuid()) @db.Uuid
  name                     String
  approved                 Boolean           @default(false) // manual approval for the private pilot
  // When Turfcut last approved it (M10.2). Stays set when approval is
  // withdrawn (approved goes false), so Settings can say the approval was
  // withdrawn rather than never given. The reason lives on the staff ledger.
  approvedAt               DateTime?
  // Publish gate (spec p.15): no job publishes until both are recorded.
  contractorTermsSignedAt  DateTime?
  classificationReviewedAt DateTime?
  legalContact             String? // legal-review contact (spec p.11)
  profiles                 Profile[]
  jobs                     Job[]
  conversations            Conversation[]
  payouts                  Payout[]
  payoutTransfers          PayoutTransfer[]
  payDisputes              PayDispute[]
  statements               Statement[]
  invites                  OrgInvite[]
  mutedBy                  OrgMute[]
  campaignProfiles         CampaignProfile[]
  adminActions             AdminAction[]
  orgRoles                 OrgRole[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

/// C1: an owner's invitation for someone to join the organization in a role.
/// Held on the server and matched to the email address the person proves
/// they own when they first sign in (never to editable sign-up details).
/// Operational state, not a ledger: resend moves expiresAt, revoke and
/// accept stamp their columns. At most one pending invite per org and email
/// (partial unique index in prisma/c1-roles.sql).
model OrgInvite {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  email        String // lowercased
  role         Role // never WORKER
  /// M10.6: the custom role an invite is for; set exactly when role is CUSTOM.
  orgRoleId    String?      @db.Uuid
  orgRole      OrgRole?     @relation("OrgRoleInvites", fields: [orgRoleId], references: [id], onDelete: Restrict)
  invitedById  String       @db.Uuid // Profile.id of the owner who sent it
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?      @db.Uuid // Profile.id created or attached on acceptance
  revokedAt    DateTime?

  @@index([email])
  @@index([orgId, createdAt])
}

/// M10.6: a role an organization defines for itself: a name and what it
/// reaches, as grants on the access map's areas. Started from a built-in
/// role as a preset (basedOn). Never deleted: archived once nobody holds it
/// (the history of who held what stays readable on the audit trail).
model OrgRole {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @db.Uuid
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  name        String
  description String         @default("")
  basedOn     Role? // the built-in role it started from, if any
  createdById String         @db.Uuid
  createdBy   Profile        @relation("OrgRoleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  archivedAt  DateTime?
  grants      OrgRoleGrant[]
  members     Profile[]      @relation("OrgRoleMembers")
  invites     OrgInvite[]    @relation("OrgRoleInvites")

  @@unique([orgId, name])
  @@index([orgId, archivedAt])
}

/// One grant of a custom role: an area (checked in code against the access
/// map's list, so a new area never needs a migration) at full or read.
model OrgRoleGrant {
  roleId String          @db.Uuid
  role   OrgRole         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  area   String
  level  RoleAccessLevel

  @@id([roleId, area])
}

/// Versioned, counsel-approved rule profile per jurisdiction.
/// Hard stop: a job may only publish when its jurisdiction profile is the
/// current approved version (enforced in application code, M2).
model JurisdictionProfile {
  id                String    @id @default(uuid()) @db.Uuid
  state             String // e.g. "CO"
  locality          String? // e.g. "Denver" — null means statewide
  version           Int       @default(1)
  isCurrent         Boolean   @default(true)
  approved          Boolean   @default(false)
  approvedAt        DateTime?
  // Versioned by effective date; counsel approval can lapse (spec p.13, p.15).
  effectiveFrom     DateTime? // null = effective immediately
  approvalExpiresAt DateTime? // null = no expiry set by counsel
  // M10.3: who proposed and approved this version (staff Profile ids), and
  // when a newer approved version took its place. The reasons live on the
  // staff ledger (AdminAction).
  createdById       String?   @db.Uuid
  approvedById      String?   @db.Uuid
  supersededAt      DateTime?
  // Compensation/eligibility/registration/badge/affidavit/disclosure rules.
  rules             Json
  jobs              Job[]
  createdAt         DateTime  @default(now())

  @@unique([state, locality, version])
}

// ---------------------------------------------------------------------------
// Jobs, engagements, shifts
// ---------------------------------------------------------------------------

enum JobType {
  PETITION
  CANVASS
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum CompensationMethod {
  HOURLY // default; always allowed
  SHIFT_RATE // only where the jurisdiction profile allows
  PER_UNIT // only where the jurisdiction profile allows
}

model Job {
  id                      String              @id @default(uuid()) @db.Uuid
  orgId                   String              @db.Uuid
  org                     Organization        @relation(fields: [orgId], references: [id])
  jurisdictionId          String              @db.Uuid
  jurisdiction            JurisdictionProfile @relation(fields: [jurisdictionId], references: [id])
  type                    JobType
  title                   String
  description             String?
  status                  JobStatus           @default(DRAFT)
  startsAt                DateTime?
  endsAt                  DateTime?
  geography               Json? // service area / turf boundaries
  compensationMethod      CompensationMethod  @default(HOURLY)
  payRateCents            Int? // gross rate in cents; worker always sees gross
  headcount               Int?
  hiringMethod            Json? // application / invite / instant-claim config
  requirements            Json? // credentials, training, badges
  // Campaign disclosure (spec p.14): affiliation, issue positions, message.
  // Shapes are defined and validated in src/lib/jobs.ts.
  campaignDisclosure      Json?
  supportContacts         Json? // who handles emergencies, disputes, lost materials
  measureIds              String[]            @default([]) // ballot measure / initiative IDs
  cancellationNoticeHours Int                 @default(24) // later worker cancellations count as no-shows
  // C4: how the day starts (self-launch or from a staging point, with the
  // points and their check-in radius) and which canvassing app the work
  // runs in. Shapes are defined and validated in src/lib/job-launch.ts.
  launch                  Json?
  tools                   Json?
  publishedAt             DateTime?
  // Matching weights are versioned on the job (M3); stored when matching ships.
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  engagements       Engagement[]
  conversationJobs  ConversationJob[]
  changes           JobChange[]
  // S1: the campaign this job works for (its profile's pinned talking points brief the job's shifts).
  campaignProfileId String?           @db.Uuid
  campaignProfile   CampaignProfile?  @relation(fields: [campaignProfileId], references: [id], onDelete: Restrict)
  embeddedInPosts   CampaignPost[]    @relation("CampaignPostJobEmbed")
  slots             ShiftSlot[]

  @@index([orgId, status])
  @@index([jurisdictionId])
  @@index([campaignProfileId])
}

enum EngagementStatus {
  APPLIED
  INVITED
  CLAIMED
  ACTIVE
  COMPLETED
  CANCELLED
  // C3 hiring pipeline: an offer waits on the worker (nothing starts without
  // their accept); declined and withdrawn end an engagement that never began.
  OFFERED
  DECLINED
  WITHDRAWN
}

/// One step in an engagement's hiring history (C3). "In review" is an event,
/// not a status: the worker sees it as a stage while the engagement stays
/// APPLIED.
enum EngagementEventType {
  APPLIED
  CLAIMED
  INVITED
  INVITE_VIEWED
  INVITE_ACCEPTED
  INVITE_DECLINED
  INVITE_WITHDRAWN
  IN_REVIEW
  OFFERED
  OFFER_ACCEPTED
  OFFER_DECLINED
  NOT_SELECTED
  WITHDRAWN
}

/// The dated history of an engagement, shown to the worker and the
/// organization. Append-only (rule 3). No free-text notes about a worker
/// (C3 decision Q5): a structured reason code on NOT_SELECTED, and a note the
/// worker reads.
model EngagementEvent {
  id           String              @id @default(uuid()) @db.Uuid
  engagementId String              @db.Uuid
  engagement   Engagement          @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  type         EngagementEventType
  /// Profile.id of who did it; null only for history filled in by the C3 migration.
  actorId      String?             @db.Uuid
  reasonCode   String? // only on NOT_SELECTED (NOT_SELECTED_REASONS in engagements.ts)
  note         String? // shown to the worker
  createdAt    DateTime            @default(now())

  @@index([engagementId, createdAt])
}

model Engagement {
  id                  String           @id @default(uuid()) @db.Uuid
  jobId               String           @db.Uuid
  job                 Job              @relation(fields: [jobId], references: [id])
  workerId            String           @db.Uuid
  worker              Worker           @relation(fields: [workerId], references: [id])
  status              EngagementStatus @default(APPLIED)
  // Frozen snapshot of the application + the scorecard shown to the employer
  // at decision time (spec: freeze the employer-facing snapshot).
  applicationSnapshot Json?
  // The org profile who hired this worker (accepted the application, sent
  // the invitation, or created the job for an instant claim). The worker's
  // direct-message thread for this job is with this person.
  hiredById           String?          @db.Uuid
  hiredBy             Profile?         @relation("HiredBy", fields: [hiredById], references: [id], onDelete: Restrict)
  // C3 invitations: the inviter's note to the worker (1–500 characters) and
  // when the invitation lapses (7 days). Null on applications, claims and
  // invitations sent before C3 (which don't lapse).
  inviteNote          String?
  inviteExpiresAt     DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  shifts        Shift[]
  payouts       Payout[]
  conversation  Conversation?
  events        EngagementEvent[]
  notifications Notification[]

  @@unique([jobId, workerId])
  @@index([workerId])
  @@index([hiredById])
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Shift {
  id              String      @id @default(uuid()) @db.Uuid
  engagementId    String      @db.Uuid
  engagement      Engagement  @relation(fields: [engagementId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  status          ShiftStatus @default(SCHEDULED)
  checkInAt       DateTime?
  checkOutAt      DateTime?
  // Field day (M3). Staging point for check-in; the worker's own position is
  // never stored — check-in records only whether they were at staging.
  stagingLocation String?
  stagingLat      Float?
  stagingLng      Float?
  supervisorId    String?     @db.Uuid // Profile.id who accepts custody and reviews
  turfArea        Json? // GeoJSON Polygon of the assigned turf
  // M8.2: the open slot this shift took a seat on, if any.
  slotId          String?     @db.Uuid
  slot            ShiftSlot?  @relation(fields: [slotId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  events      WorkEvent[]
  validations Validation[]
  payouts     Payout[]
  payDisputes PayDispute[]

  @@index([engagementId, startsAt])
  @@index([slotId])
}

enum ShiftSlotStatus {
  OPEN
  CLOSED
}

// M8.2: an open shift staff post on a job. Hired workers take a seat first
// come, first served; each seat is a real Shift (slotId). Seats held = the
// slot's shifts that aren't cancelled. Times and place are fixed once posted
// (close it and post another); only the seats and the status change.
model ShiftSlot {
  id              String          @id @default(uuid()) @db.Uuid
  jobId           String          @db.Uuid
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  startsAt        DateTime
  endsAt          DateTime
  headcount       Int
  stagingLocation String?
  stagingLat      Float?
  stagingLng      Float?
  supervisorId    String?         @db.Uuid
  supervisor      Profile?        @relation("ShiftSlotSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  turfArea        Json?
  notes           String?
  status          ShiftSlotStatus @default(OPEN)
  closedAt        DateTime?
  createdById     String          @db.Uuid
  createdBy       Profile         @relation("ShiftSlotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  shifts Shift[]

  @@index([jobId, startsAt])
  @@index([supervisorId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Work events (APPEND-ONLY) and validations (APPEND-ONLY)
// ---------------------------------------------------------------------------

enum WorkEventType {
  CHECK_IN
  CHECK_OUT
  PAUSE_START
  PAUSE_END
  DOOR_KNOCK
  CONTACT
  SIGNATURE_SUBMITTED
  CALL
  INTERVIEW
  PACKET_PICKUP // serialized petition packet checked out
  PACKET_RETURN // serialized petition packet returned
  BATCH_COUNT // supervisor batch reconciliation count
  INCIDENT // safety incident / harassment report
  CORRECTION // signed metric correction event (supersedes, never rewrites)
  SHIFT_CANCELLED // payload: { by: "WORKER" | "ORGANIZATION", reason } — append-only record of a cancellation
  NOTE
  APP_COUNTS // C4.4: the canvassing app's returned totals for the shift — payload: { app, doors, contacts }; the newest replaces logged doors/contacts
  PACKET_HELD // C4.5: a packet the worker keeps between shifts — payload: { packetId }; it is picked up again on their next shift
}

/// Immutable ledger of everything that happened on a shift.
/// NEVER update or delete rows. Corrections are new CORRECTION events.
model WorkEvent {
  id         String        @id @default(uuid()) @db.Uuid
  shiftId    String        @db.Uuid
  shift      Shift         @relation(fields: [shiftId], references: [id])
  type       WorkEventType
  payload    Json // event-specific data (counts, packet IDs, notes, ...)
  actorId    String?       @db.Uuid // Profile.id who recorded it (worker or supervisor); null on pre-M3 rows
  createdAt  DateTime      @default(now()) // when it happened (for offline actions: the phone's corrected time)
  // Offline field day (M6): the phone's id for the action, so a re-sent
  // action is saved once; and when an action recorded offline reached the
  // server (null = recorded live).
  clientId   String?       @unique @db.Uuid
  receivedAt DateTime?

  @@index([shiftId, createdAt])
}

enum ValidationStatus {
  APPROVED
  REJECTED
  FLAGGED // anomaly flag for supervisor review
}

/// Supervisor review decisions. APPEND-ONLY: a rejection/appeal is a new row.
model Validation {
  id          String           @id @default(uuid()) @db.Uuid
  shiftId     String           @db.Uuid
  shift       Shift            @relation(fields: [shiftId], references: [id])
  workEventId String?          @db.Uuid
  status      ValidationStatus
  reason      String?
  reviewerId  String?          @db.Uuid // Profile.id of the supervisor
  createdAt   DateTime         @default(now())

  payouts Payout[]

  @@index([shiftId])
}

// ---------------------------------------------------------------------------
// Derived metrics (versioned aggregates — computed, never hand-edited)
// ---------------------------------------------------------------------------

/// Scorecard aggregates derived from work_events. Each recompute writes a new
/// row with an incremented version; prior versions are preserved.
model ProfileMetric {
  id         String   @id @default(uuid()) @db.Uuid
  workerId   String   @db.Uuid
  // Versioned aggregates are never erased with the worker (rule 3).
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  version    Int      @default(1)
  // doorsPerActiveHour, contactRate, signaturesPerActiveHour, acceptanceRate,
  // showRate, totals by verification level — see lib/metrics.ts for formulas.
  metrics    Json
  computedAt DateTime @default(now())

  @@unique([workerId, version])
  @@index([workerId])
}

// ---------------------------------------------------------------------------
// Payouts (APPEND-ONLY ledger)
// ---------------------------------------------------------------------------

enum PayoutKind {
  SHIFT // pay for one approved shift
  ADJUSTMENT // a correction to pay (positive or negative), e.g. a resolved dispute
}

enum PayoutEventType {
  APPROVED // finance or the owner approved the line for payment
  HELD // payment put on hold (reason required)
  RELEASED // hold lifted
  VOIDED // the shift was re-reviewed before payment; this line no longer pays
  TRANSFER_STARTED // included in a payout transfer (transferId)
  PAID // the transfer went through (providerRef = Stripe transfer id)
  TRANSFER_FAILED // the provider refused the transfer; the line can be paid again
  REVERSED // a paid transfer was reversed; the line can be paid again or held
}

/// One pay line: what a worker earned for an approved shift, or an
/// adjustment to it. NEVER updated or deleted (database trigger) — status
/// lives in PayoutEvent, and a correction is a new ADJUSTMENT line.
model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  workerId     String       @db.Uuid
  worker       Worker       @relation(fields: [workerId], references: [id])
  orgId        String       @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id])
  engagementId String?      @db.Uuid
  engagement   Engagement?  @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  shiftId      String?      @db.Uuid
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  // The supervisor's approval (closeout) this line pays for.
  validationId String?      @db.Uuid
  validation   Validation?  @relation(fields: [validationId], references: [id], onDelete: Restrict)
  kind         PayoutKind   @default(SHIFT)
  amountCents  Int // gross to the worker (never reduced by a commission); negative only for ADJUSTMENT
  feeCents     Int          @default(0) // platform fee, charged to the organization on top
  // Frozen calculation: method, rate, verified quantity, formula text,
  // jurisdiction version (lib/pay.ts PayBasis). Never recomputed.
  basis        Json?
  adjustsId    String?      @db.Uuid // ADJUSTMENT: the line it corrects
  adjusts      Payout?      @relation("Adjusts", fields: [adjustsId], references: [id], onDelete: Restrict)
  adjustments  Payout[]     @relation("Adjusts")
  createdById  String?      @db.Uuid // Profile: the approving supervisor, or who adjusted
  createdAt    DateTime     @default(now())

  events     PayoutEvent[]
  disputes   PayDispute[]
  resolution PayDisputeResolution?

  @@index([workerId, createdAt])
  @@index([orgId, createdAt])
  @@index([shiftId])
  @@index([engagementId])
  @@index([adjustsId])
}

/// Status history of a pay line. APPEND-ONLY.
model PayoutEvent {
  id          String          @id @default(uuid()) @db.Uuid
  payoutId    String          @db.Uuid
  payout      Payout          @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  type        PayoutEventType
  actorId     String?         @db.Uuid // Profile; null for the provider / system
  reason      String?
  transferId  String?         @db.Uuid
  transfer    PayoutTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  providerRef String? // Stripe transfer id on PAID / REVERSED
  createdAt   DateTime        @default(now())

  @@index([payoutId, createdAt])
  @@index([transferId])
}

/// One payment to one worker covering their approved lines in a pay run.
/// The id is also the Stripe idempotency key and transfer group, so a retry
/// finds or repeats the same transfer instead of paying twice. APPEND-ONLY.
model PayoutTransfer {
  id          String       @id @default(uuid()) @db.Uuid
  workerId    String       @db.Uuid
  worker      Worker       @relation(fields: [workerId], references: [id])
  orgId       String       @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id])
  amountCents Int // sum of the lines' gross pay — what the worker receives
  feeCents    Int // sum of the lines' platform fees (invoiced to the organization)
  // M9: the worker's receipt number, counted per organization (R-000123), assigned when the transfer is recorded.
  receiptNo   Int
  destination String // the worker's Stripe account at the time
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())

  events  PayoutEvent[]
  notices Notification[]

  @@unique([orgId, receiptNo])
  @@index([orgId, createdAt])
  @@index([workerId, createdAt])
}

enum DisputeOutcome {
  KEPT // pay stays as it is; the response says why
  ADJUSTED // an ADJUSTMENT line was added
  REREVIEWED // a supervisor re-reviewed the shift after the dispute
}

/// A worker's dispute of a shift's pay (approved or not). APPEND-ONLY;
/// the outcome is a separate row.
model PayDispute {
  id         String       @id @default(uuid()) @db.Uuid
  shiftId    String       @db.Uuid
  shift      Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  workerId   String       @db.Uuid
  worker     Worker       @relation(fields: [workerId], references: [id])
  orgId      String       @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id])
  payoutId   String?      @db.Uuid // the line disputed, when the shift has one
  payout     Payout?      @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  openedById String       @db.Uuid
  reason     String
  createdAt  DateTime     @default(now())

  resolution PayDisputeResolution?
  messages   PayDisputeMessage[]
  notices    Notification[]

  @@index([orgId, createdAt])
  @@index([shiftId])
  @@index([workerId])
  @@index([payoutId])
}

/// A message in a dispute's thread (M9): the worker, or an owner or finance
/// member, writing to the other side. APPEND-ONLY (database trigger).
model PayDisputeMessage {
  id        String     @id @default(uuid()) @db.Uuid
  disputeId String     @db.Uuid
  dispute   PayDispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  authorId  String     @db.Uuid
  author    Profile    @relation("DisputeMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime   @default(now())

  @@index([disputeId, createdAt])
  @@index([authorId])
}

/// One organization's calendar month of pay (M9.3), written once when the
/// month is over and someone with a pay role first looks at it. The totals
/// are frozen then; the lines are always read from the ledger by period, so
/// the statement can't disagree with it. Corrections after close land on
/// the next statement and name this one. NEVER updated or deleted (trigger).
model Statement {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @db.Uuid
  org              Organization @relation(fields: [orgId], references: [id])
  period           String // UTC calendar month, "2026-10"
  number           String // "S-2026-10"
  grossCents       Int // lines recorded in the month and not withdrawn at close
  feeCents         Int // their platform fees
  lineCount        Int
  paidCents        Int // gross that reached workers in the month
  paidCount        Int // transfers
  reversedCents    Int // gross that came back in the month
  correctionsCents Int // adjustments and withdrawals, recorded this month, to earlier months' lines
  closedAt         DateTime     @default(now())
  closedById       String?      @db.Uuid // Profile whose visit closed it; null when closed by the system

  @@unique([orgId, period])
  @@index([orgId, closedAt])
}

/// How a dispute was closed. One per dispute. APPEND-ONLY.
model PayDisputeResolution {
  id           String         @id @default(uuid()) @db.Uuid
  disputeId    String         @unique @db.Uuid
  dispute      PayDispute     @relation(fields: [disputeId], references: [id])
  outcome      DisputeOutcome
  response     String
  resolvedById String         @db.Uuid
  adjustmentId String?        @unique @db.Uuid
  adjustment   Payout?        @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
}

/// Stripe webhook events already handled (each is processed once). APPEND-ONLY.
model ProviderEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Audit log (APPEND-ONLY)
// ---------------------------------------------------------------------------

/// Every state change across the five ledger moments: job configured, worker
/// matched, shift executed, work reviewed, payout reconciled.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid // Profile.id, null for system events
  action     String // e.g. "job.published", "shift.completed"
  entityType String // e.g. "Job", "Shift", "Payout"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// M10: the staff ledger. One row per act a Turfcut staff member takes on
/// the platform (approving an organization, a jurisdiction version, a
/// campaign verification, a support action): who, what, on which record,
/// for which organization, and why, in their own words. Append-only (rule
/// 3): a correction is a new row that supersedes. Server-only: no Data API
/// grants. Staff notes stay out of the organization's own audit trail.
model AdminAction {
  id         String        @id @default(uuid()) @db.Uuid
  staffId    String        @db.Uuid
  staff      Profile       @relation("AdminActionStaff", fields: [staffId], references: [id], onDelete: Restrict)
  action     String // e.g. "org.approved", "jurisdiction.version_approved"
  targetType String // e.g. "Organization", "JurisdictionProfile", "Profile", "OrgInvite" (lib/admin-data.ts lists them)
  targetId   String
  orgId      String?       @db.Uuid // the organization the act concerns, when there is one
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)
  reason     String // never empty (checked in code and in SQL)
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([targetType, targetId])
  @@index([orgId, createdAt])
  @@index([staffId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// M4 — in-app messaging. Access is decided in src/lib/chat.ts (server) and,
// for Supabase Realtime, by RLS policies in prisma/m4-migration.sql.
// Messages are immutable; edits and deletes are MessageRevision rows.
// ---------------------------------------------------------------------------

enum ConversationKind {
  DIRECT // worker ↔ the person who hired them, one per engagement
  GROUP // team chat created by an organizer
}

enum ParticipantRole {
  WORKER
  MANAGER
}

enum RevisionKind {
  EDIT
  DELETE
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  kind          ConversationKind
  orgId         String           @db.Uuid
  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  engagementId  String?          @unique @db.Uuid // DIRECT: exactly one thread per (worker, job)
  engagement    Engagement?      @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  name          String? // GROUP: "Denver housing initiative — Team A"
  createdById   String           @db.Uuid // Profile
  lastMessageAt DateTime? // thread-list ordering; only moves forward
  createdAt     DateTime         @default(now())

  participants ConversationParticipant[]
  jobs         ConversationJob[]
  messages     Message[]

  @@index([orgId, kind])
}

/// GROUP ↔ related jobs: a worker may post only while hired on one of them.
model ConversationJob {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  jobId          String       @db.Uuid
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([conversationId, jobId])
  @@index([jobId])
}

model ConversationParticipant {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @db.Uuid
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  profileId      String          @db.Uuid
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Restrict)
  role           ParticipantRole
  addedById      String          @db.Uuid
  addedAt        DateTime        @default(now())
  removedAt      DateTime? // set = read-only; history visible up to this moment
  removedById    String?         @db.Uuid
  lastReadAt     DateTime? // unread = messages after this

  @@unique([conversationId, profileId])
  @@index([profileId])
}

/// Immutable: never updated or deleted. See MessageRevision.
model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId       String       @db.Uuid
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String // ≤ 4,000 characters
  attachmentPath String? // private storage key, never a public URL
  attachmentName String?
  attachmentType String? // MIME type checked from the file's bytes
  attachmentSize Int?
  createdAt      DateTime     @default(now())

  revisions MessageRevision[]
  reports   MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// Append-only edits and soft deletes (tombstones). Latest EDIT wins; any DELETE hides the text.
model MessageRevision {
  id             String       @id @default(uuid()) @db.Uuid
  messageId      String       @db.Uuid
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Restrict)
  conversationId String       @db.Uuid // denormalized for realtime filtering
  kind           RevisionKind
  body           String? // EDIT: the new text; DELETE: null
  actorId        String       @db.Uuid
  createdAt      DateTime     @default(now())

  @@index([messageId, createdAt])
  @@index([conversationId, createdAt])
}

model MessageReport {
  id             String    @id @default(uuid()) @db.Uuid
  messageId      String    @db.Uuid
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Restrict)
  conversationId String    @db.Uuid
  orgId          String    @db.Uuid
  reporterId     String    @db.Uuid
  reason         String // ≤ 500 characters
  bodySnapshot   String // the text when reported; survives later edits/deletes
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?   @db.Uuid

  @@unique([messageId, reporterId]) // one report per person per message
  @@index([orgId, createdAt])
}

/// A worker blocking an employer/manager. Unblocking sets liftedAt; rows stay.
/// Messages sent while a block was active stay hidden from the blocker.
/// One active block per pair (partial unique index in m4-migration.sql).
model ProfileBlock {
  id        String    @id @default(uuid()) @db.Uuid
  blockerId String    @db.Uuid
  blocker   Profile   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blockedId String    @db.Uuid
  blocked   Profile   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  liftedAt  DateTime?

  @@index([blockedId])
}

/// Rate-limit counts (src/lib/rate-limit.ts), shared by every server
/// instance: one row per bucket ("login:203.0.113.9") per fixed window.
/// Times are epoch milliseconds. Operational state, not a ledger: rows are
/// deleted once expiresAt passes. Server-only (RLS on, no policies).
model RateLimitCounter {
  bucket      String
  windowStart BigInt
  count       Int
  expiresAt   BigInt

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// C2: what each organization sees. All three tables are APPEND-ONLY: a change
// appends a version (or a superseding row) and the latest wins (rule 3).
// Server-only (RLS on, no policies).
// ---------------------------------------------------------------------------

/// Who may see one part of a worker's profile (C2).
enum ShareAudience {
  RELATIONSHIP // organizations the worker applied to or accepted an invitation from
  ANY_APPROVED_ORG // any organization Turfcut approved that could hire them (takes effect with Matches, C3)
  NOBODY
}

enum CredentialKind {
  CIRCULATOR_REGISTRATION
  NOTARY_OR_AFFIDAVIT
  TRAINING
  OTHER
}

/// The worker's sharing choices, one version per save. No row = the defaults
/// in src/lib/sharing.ts (RELATIONSHIP for every part, not findable).
model WorkerSharing {
  id                   String        @id @default(uuid()) @db.Uuid
  workerId             String        @db.Uuid
  worker               Worker        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  version              Int
  outputAudience       ShareAudience // doors and signatures per hour, doors per shift
  qualityAudience      ShareAudience // signature acceptance, contact rate
  reliabilityAudience  ShareAudience // show rate
  historyAudience      ShareAudience // verified shifts, hours, campaigns, states, dates, totals
  availabilityAudience ShareAudience
  credentialsAudience  ShareAudience
  readReceipts         Boolean       @default(false) // used from C3
  // Findability: off by default. The home area is what the worker typed (a
  // city or ZIP), never a location from the phone.
  findable             Boolean       @default(false)
  workTypes            JobType[]     @default([])
  homeArea             String?
  travelMiles          Int?
  consentTextVersion   String
  actorId              String        @db.Uuid // Profile.id who saved it
  createdAt            DateTime      @default(now())

  // Unique so two concurrent saves can't both claim version N+1.
  @@unique([workerId, version])
}

/// The worker's usual week and date exceptions, one version per save.
/// Never scored or ranked. Shapes are validated in src/lib/availability.ts.
model WorkerAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  workerId   String   @db.Uuid
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  version    Int
  weekly     Json // per weekday, up to two { from: "09:00", to: "15:00" } ranges
  exceptions Json // [{ date: "2026-10-12", ranges: [] }] (no ranges = not available that day)
  note       String?
  actorId    String   @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([workerId, version])
}

/// A credential the worker holds. An edit appends a row that supersedes the
/// previous one; taking one down appends a row with removed = true. The
/// current credentials are the rows nothing supersedes that aren't removed.
model WorkerCredential {
  id                 String              @id @default(uuid()) @db.Uuid
  workerId           String              @db.Uuid
  worker             Worker              @relation(fields: [workerId], references: [id], onDelete: Restrict)
  kind               CredentialKind
  label              String? // the worker's name for an OTHER credential or a training course
  state              String? // two-letter state, when the credential has one
  identifier         String? // only the last 4 characters of what the worker typed (credentials.ts), shown masked
  issuedOn           DateTime?           @db.Date
  expiresOn          DateTime?           @db.Date
  verification       VerificationLevel   @default(SELF_REPORTED)
  verifiedById       String?             @db.Uuid
  verifiedAt         DateTime?
  // How it was verified (C3.6): set exactly when verification isn't SELF_REPORTED.
  verificationMethod VerificationMethod?
  proofPath          String? // unused: proof photos (C3) get their own table; see README "Credential proof photos"
  // Unique: two edits racing on one row can't both supersede it.
  supersedesId       String?             @unique @db.Uuid
  supersedes         WorkerCredential?   @relation("Supersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy       WorkerCredential?   @relation("Supersedes")
  proofs             CredentialProof[]
  removed            Boolean             @default(false)
  actorId            String              @db.Uuid
  createdAt          DateTime            @default(now())

  @@index([workerId, createdAt])
}

/// C3: a worker has muted an organization. While the row exists the
/// organization can't invite them (it reads as "Worker not found", like any
/// worker it can't reach), and its jobs still show in the worker's feed.
/// Unmuting removes the row; both are audited. Server-only.
model OrgMute {
  id        String       @id @default(uuid()) @db.Uuid
  workerId  String       @db.Uuid
  worker    Worker       @relation(fields: [workerId], references: [id], onDelete: Restrict)
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@unique([workerId, orgId])
  @@index([orgId])
}

/// C3.5: what an in-app notice is about. The words are drawn when it's shown,
/// from the engagement as the recipient may see it then; nothing else is stored.
enum NotificationKind {
  APPLICATION_RECEIVED
  CLAIM_RECEIVED
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_WITHDRAWN
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  NOT_SELECTED
  APPLICATION_WITHDRAWN
  JOB_CLOSED
  JOB_CHANGED // C4.3: a published job's terms changed
  CAMPAIGN_POST // S2.4: a campaign the worker follows (with notices on) posted
  // M9: pay disputes (about a dispute) and payouts (about a transfer)
  DISPUTE_OPENED // to the organization's pay roles: a worker disputed a shift's pay
  DISPUTE_MESSAGE // to the other side: a message in the dispute thread
  DISPUTE_RESOLVED // to the worker: the dispute was closed
  DISPUTE_OVERDUE // to the pay roles: a deadline passed
  PAYOUT_SENT // to the worker: a transfer went through (the receipt)
  PAYOUT_REVERSED // to the worker: a paid transfer was reversed
  // M10.2: Turfcut's decision on the organization, to its owners. No subject
  // row: the notice is about the organization the recipient belongs to.
  ORG_APPROVED
  ORG_APPROVAL_REVOKED
  ORG_JOBS_FROZEN // M10.3: a jurisdiction rule change or a withdrawn approval froze some of the organization's jobs
}

/// C3.5: an in-app notice for one person about one engagement. readAt is the
/// recipient's own: never shown to anyone else (no read receipts). Server-only.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  recipientId  String           @db.Uuid
  recipient    Profile          @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  kind         NotificationKind
  /// What it's about: exactly one of an engagement (hiring steps), a
  /// campaign post (CAMPAIGN_POST), a pay dispute (DISPUTE_*) or a payout
  /// transfer (PAYOUT_*); checked in SQL (prisma/m9-money.sql). An ORG_*
  /// notice (M10.2) has no subject: it is about the recipient's organization.
  engagementId String?          @db.Uuid
  engagement   Engagement?      @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  postId       String?          @db.Uuid
  post         CampaignPost?    @relation(fields: [postId], references: [id], onDelete: Restrict)
  disputeId    String?          @db.Uuid
  dispute      PayDispute?      @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  transferId   String?          @db.Uuid
  transfer     PayoutTransfer?  @relation(fields: [transferId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())
  readAt       DateTime?

  @@index([recipientId, readAt, createdAt])
  @@index([engagementId])
  @@index([postId])
  @@index([disputeId])
  @@index([transferId])
}

/// A photo of a Colorado circulator training certificate, added by the
/// worker to that credential (C3.6b). Append-only: removing one appends a
/// CredentialProofDeletion and deletes the stored file. The file is
/// encrypted in the private "credential-proofs" bucket at
/// <workerId>/<id>; only its fingerprint and size are kept here. A photo
/// is evidence a person checks, never verification by itself.
model CredentialProof {
  id           String                   @id @default(uuid()) @db.Uuid
  workerId     String                   @db.Uuid
  worker       Worker                   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  /// The credential row it was added to; it stays with that credential through the worker's edits.
  credentialId String                   @db.Uuid
  credential   WorkerCredential         @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  side         ProofSide
  sha256       String // of the re-encoded image, before encryption
  sizeBytes    Int
  width        Int
  height       Int
  /// The worker's choice when adding it: organizations that hired them may see it.
  shared       Boolean
  actorId      String                   @db.Uuid
  createdAt    DateTime                 @default(now())
  deletion     CredentialProofDeletion?

  @@index([workerId, createdAt])
  @@index([credentialId])
}

/// That a proof photo was deleted, why and by whom (null: the daily purge).
model CredentialProofDeletion {
  id        String              @id @default(uuid()) @db.Uuid
  proofId   String              @unique @db.Uuid
  proof     CredentialProof     @relation(fields: [proofId], references: [id], onDelete: Restrict)
  reason    ProofDeletionReason
  actorId   String?             @db.Uuid
  createdAt DateTime            @default(now())
}

/// C4.3: an edit to a published job, as a record: what changed (field →
/// before and after), who, when, and which of it is material (pay, dates,
/// location, requirements, the campaign, how the day starts, the notice
/// window). Append-only. Hired workers are told, and for a material change
/// may leave within RELEASE_HOURS with no reliability penalty.
model JobChange {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  actorId   String   @db.Uuid
  changes   Json
  /// The material parts that changed, as labels ("pay", "dates"); empty for a change workers aren't released over.
  material  String[] @default([])
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

/// S1: a campaign's public page. An organization may run several campaigns,
/// each with its own profile; jobs link to the one they work for. Every word
/// is the campaign's own, shown verbatim: Turfcut never labels, summarizes or
/// infers politics from it. Public once published, and only while the
/// organization is approved by Turfcut.
model CampaignProfile {
  id           String             @id @default(uuid()) @db.Uuid
  orgId        String             @db.Uuid
  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  handle       String             @unique // lowercase a-z 0-9 _, 3-30 (checked in SQL and code)
  displayName  String
  bio          String             @default("")
  avatarKey    String?
  headerKey    String?
  publishedAt  DateTime? // null = draft, not public
  /// M10.5: when Turfcut staff confirmed this is the organization's official campaign account, and who. Both null or both set; the reason is on the AdminAction ledger. Changing the name or handle, unpublishing, or withdrawing the organization's approval clears it.
  verifiedAt   DateTime?
  verifiedById String?            @db.Uuid
  verifiedBy   Profile?           @relation("CampaignVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  posts        CampaignPost[]
  jobs         Job[]
  followers    CampaignFollow[]
  resources    CampaignResource[]

  @@index([orgId])
  @@index([verifiedAt])
}

/// S1: a post on a campaign's profile, up to 500 characters, optionally
/// embedding one of the organization's jobs. Pinned posts (at most 3) are the
/// campaign's talking points and brief its jobs' shifts. Deleting hides the
/// post and keeps the row; every version of the text is a revision.
model CampaignPost {
  id          String                 @id @default(uuid()) @db.Uuid
  profileId   String                 @db.Uuid
  profile     CampaignProfile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  authorId    String                 @db.Uuid
  author      Profile                @relation("CampaignPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  jobId       String?                @db.Uuid
  job         Job?                   @relation("CampaignPostJobEmbed", fields: [jobId], references: [id], onDelete: Restrict)
  pinnedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?                @db.Uuid
  deletedBy   Profile?               @relation("CampaignPostDeleter", fields: [deletedById], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now())
  editedAt    DateTime?
  revisions   CampaignPostRevision[]
  likes       PostLike[]
  facts       TalkingPointFact[]
  notices     Notification[]

  @@index([profileId, createdAt])
  @@index([jobId])
  @@index([authorId])
  @@index([deletedById])
}

/// S1: every version of a post's text and embed, oldest first (the first is
/// the post as written). Append-only and server-only.
model CampaignPostRevision {
  id        String       @id @default(uuid()) @db.Uuid
  postId    String       @db.Uuid
  post      CampaignPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  body      String
  jobId     String?      @db.Uuid // the embed at this version: a snapshot, deliberately not a foreign key
  editorId  String       @db.Uuid
  editor    Profile      @relation(fields: [editorId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@index([postId, createdAt])
  @@index([editorId])
}

/// S4: a supporting fact behind a talking point (a pinned post): a short
/// claim with an optional source link, up to MAX_FACTS per post. Shown with
/// the talking point on the campaign page and in every shift brief on the
/// campaign's jobs. Edited in place by the campaign's managers; removing one
/// hides it and keeps the row; every change is on the audit record.
model TalkingPointFact {
  id        String       @id @default(uuid()) @db.Uuid
  postId    String       @db.Uuid
  post      CampaignPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  body      String
  sourceUrl String?
  position  Int
  authorId  String       @db.Uuid
  author    Profile      @relation("TalkingPointFactAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([postId, position])
  @@index([authorId])
}

/// What a campaign resource is: a script to say at the door, answers to the
/// questions people ask, or a guide to how the day works.
enum CampaignResourceKind {
  SCRIPT
  FAQ
  GUIDE
}

/// Who a resource is for: anyone on the campaign page, or the workers on
/// the campaign's jobs and their field staff (in the shift brief only).
enum CampaignResourceAudience {
  PUBLIC
  WORKERS
}

/// S4: a campaign's field kit: scripts, common questions, guides. Written
/// by the campaign's managers, in its own words; shown on the campaign page
/// (PUBLIC) or in the shift brief of the campaign's jobs (both audiences).
/// Edited in place; removing one hides it and keeps the row; audited.
model CampaignResource {
  id        String                   @id @default(uuid()) @db.Uuid
  profileId String                   @db.Uuid
  profile   CampaignProfile          @relation(fields: [profileId], references: [id], onDelete: Restrict)
  kind      CampaignResourceKind
  audience  CampaignResourceAudience @default(WORKERS)
  title     String
  body      String
  position  Int
  authorId  String                   @db.Uuid
  author    Profile                  @relation("CampaignResourceAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  deletedAt DateTime?

  @@index([profileId, kind, position])
  @@index([authorId])
}

/// S2: a worker following a campaign. Each row is one stretch of following:
/// unfollowing ends it (revokedAt, set once); following again, or changing
/// the notify setting, starts a new row. Append-only otherwise. One open row
/// per worker and campaign (partial unique index in prisma/s2-social.sql).
/// Private to the worker: campaigns never see who follows them, there are no
/// follower counts, and nothing here is ever read by matching (C1-Q14).
model CampaignFollow {
  id         String          @id @default(uuid()) @db.Uuid
  workerId   String          @db.Uuid
  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  campaignId String          @db.Uuid
  campaign   CampaignProfile @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  /// Opted in to notices of the campaign's new posts (S2.4).
  notify     Boolean         @default(false)
  createdAt  DateTime        @default(now())
  revokedAt  DateTime?

  @@index([workerId, revokedAt])
  @@index([campaignId, revokedAt])
}

/// S2: a worker's like on a post. Unliking ends the row (removedAt, set
/// once); liking again starts a new one. Private to the worker: a campaign
/// sees only how many likes a post has, never who.
model PostLike {
  id        String       @id @default(uuid()) @db.Uuid
  workerId  String       @db.Uuid
  worker    Worker       @relation(fields: [workerId], references: [id], onDelete: Restrict)
  postId    String       @db.Uuid
  post      CampaignPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())
  removedAt DateTime?

  @@index([workerId, removedAt])
  @@index([postId, removedAt])
}
