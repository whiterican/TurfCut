// Turfcut — M0 Prisma schema.
// Distilled from the Turfcut MVP Spec data model (p.17) and the build plan.
//
// INVARIANTS (see CLAUDE.md — non-negotiable):
// - work_events, validations, payouts, audit_events are APPEND-ONLY.
//   Never UPDATE or DELETE rows. Corrections are new events that supersede.
// - profile_metrics stores versioned aggregates derived from work_events.
// - Jurisdiction hard stop: a job cannot publish unless its jurisdiction
//   profile is approved and current (enforced in application code, M2).
// - political_preferences: consent versioning — a preference change writes a
//   NEW row with an incremented consentVersion. Employers only ever see
//   worker-authorized overlap.

generator client {
  provider = "prisma-client-js"
}

// Two connections (Supabase):
// - DATABASE_URL: what the app uses at runtime. On Vercel, the pooler in
//   transaction mode, port 6543 (src/lib/env.ts adds pgbouncer=true and
//   connection_limit=3 when missing).
// - DIRECT_URL: the direct connection, port 5432, used by the Prisma CLI
//   (db push, migrate) which needs a session the pooler can't give.
// Locally both can be the same URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / roles
// ---------------------------------------------------------------------------

enum Role {
  WORKER // field worker (1099 contractor)
  OWNER // organization owner
  RECRUITER // organization recruiter seat
  COMPLIANCE // organization compliance reviewer
  SUPERVISOR // field supervisor (reviews work)
  FINANCE // organization finance (payouts, exports)
  PUBLISHER // C1: campaign communications (campaign profiles and feed land in C6)
}

/// Links a Supabase Auth user to a Turfcut role.
/// M0: one role per user. C1: owners add members through OrgInvite; removing a
/// member detaches them (orgId = null) and keeps their login and history. Worker users get a workers row; company users get an
/// organizations row and one of the org roles.
model Profile {
  id        String   @id @db.Uuid // == Supabase auth.users.id
  role      Role
  worker    Worker?
  orgId     String?  @db.Uuid
  org       Organization? @relation(fields: [orgId], references: [id])
  // Org staff's name as shown in chat ("Maya Chen · Manager"). Workers use
  // Worker.displayName. Never shown to anyone outside a shared conversation.
  displayName String?
  // Account closure (M7): set when the person closed their account. The
  // auth user is deleted; this row and everything it anchors stay (rule 3).
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hiredEngagements   Engagement[]              @relation("HiredBy")
  chatParticipations ConversationParticipant[]
  sentMessages       Message[]
  blocksMade         ProfileBlock[]            @relation("Blocker")
  blocksReceived     ProfileBlock[]            @relation("Blocked")

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Workers
// ---------------------------------------------------------------------------

enum VerificationLevel {
  PLATFORM // verified by Turfcut
  ORGANIZATION // verified by a hiring organization
  IMPORTED // imported from a trusted external source
  SELF_REPORTED // worker-entered; visible but excluded from verified totals
}

model Worker {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @unique @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  displayName String
  phone     String?
  // Account closure (M7): name and phone are anonymized; history stays.
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experience   ExperienceRecord[]
  preferences  PoliticalPreference[]
  engagements  Engagement[]
  metrics      ProfileMetric[]
  payouts      Payout[]
  sharing        WorkerSharing[]
  availabilities WorkerAvailability[]
  credentials    WorkerCredential[]

  // Payouts (M5): the worker's Stripe Connect account. Bank and tax details
  // stay with Stripe; payoutsEnabled caches whether Stripe can pay them.
  stripeAccountId  String?   @unique
  payoutsEnabled   Boolean   @default(false)
  payoutsCheckedAt DateTime?

  payoutTransfers PayoutTransfer[]
  payDisputes     PayDispute[]
}

/// One past campaign on a worker's profile. The verification level travels
/// with the record. Workers can only create SELF_REPORTED rows; PLATFORM,
/// ORGANIZATION and IMPORTED are set by Turfcut, a hiring org, or an import —
/// never by the worker. SELF_REPORTED rows are visible but excluded from
/// verified totals.
model ExperienceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  workerId          String            @db.Uuid
  worker            Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  // Spec p.9 "Fields on every experience record". Option lists for the
  // String fields are defined and validated in src/lib/experience.ts.
  // Campaign: organization, project (= campaign), type, role, channel
  organizationName  String?
  campaign          String
  campaignType      String? // e.g. "ballot_initiative", "candidate"
  experienceGroup   String? // e.g. "petition_circulation", "door_to_door"
  role              String
  channel           String? // e.g. "door", "public_intercept", "phone"
  // Where
  state             String?           @db.VarChar(2)
  countyOrDistrict  String?
  turfType          String? // "urban" | "suburban" | "rural"
  // When
  startDate         DateTime          @db.Date
  endDate           DateTime?         @db.Date // null = ongoing
  completedShifts   Int?
  activeHours       Float?
  // What: submitted output (unitCount) and approved output
  unitType          String // e.g. "signatures", "doors"
  unitCount         Int
  approvedCount     Int?
  // Proof
  referenceContact  String? // never shown to employers
  verificationLevel VerificationLevel @default(SELF_REPORTED)
  verifiedById      String?           @db.Uuid // Profile.id of the verifier
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([workerId])
}

/// Worker-controlled political-fit signals. NEVER inferred — every value here
/// is explicitly self-reported by the worker (spec: "worker-controlled, never
/// inferred"). Consent versioning: edits append a new row; the latest
/// consentVersion is authoritative.
enum VisibilityMode {
  PRIVATE // never shown to any employer
  MATCHING_ONLY // usable for matching, shown as "not shared"
  APPLIED_TO // visible to orgs the worker applied to / was invited by
  APPROVED_RECRUITERS // visible to recruiters the worker explicitly approved
}

model PoliticalPreference {
  id              String         @id @default(uuid()) @db.Uuid
  workerId        String         @db.Uuid
  // Consent history outlives nothing: a worker with versions can't be deleted (owner decision; rule 3).
  worker          Worker         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  visibilityMode  VisibilityMode
  // JSON shapes are defined and validated in src/lib/political-fit.ts.
  // Each answer carries its own opt-in `shared` flag.
  identityLabels  Json? // e.g. [{"label": "independent", "shared": true}, {"label": "other", "text": "..."}]
  partyRelationship Json? // e.g. {"relationship": "leans_toward", "party": "democratic"} — NOT voter registration
  issuePositions  Json? // e.g. {"housing_affordability": {"position": "lean_support", "importance": "high"}}
  campaignBoundaries Json? // e.g. [{"kind": "campaign_type", "target": "candidate", "stance": "ask_me_first"}]
  consentVersion  Int            @default(1)
  // Worker-chosen expiry (null = no expiry). After it passes — or when the
  // consent wording changes (consentTextVersion differs from the current
  // one) — answers are treated as not shared until the worker reconfirms,
  // which writes a new version.
  expiresAt          DateTime?
  consentTextVersion String? // null on rows written before consent wording was versioned
  createdAt       DateTime       @default(now())

  // Unique so two concurrent saves can't both claim version N+1.
  @@unique([workerId, consentVersion])
}

// ---------------------------------------------------------------------------
// Organizations & jurisdiction
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  approved  Boolean  @default(false) // manual approval for the private pilot
  // Publish gate (spec p.15): no job publishes until both are recorded.
  contractorTermsSignedAt  DateTime?
  classificationReviewedAt DateTime?
  legalContact             String? // legal-review contact (spec p.11)
  profiles      Profile[]
  jobs          Job[]
  conversations Conversation[]
  payouts         Payout[]
  payoutTransfers PayoutTransfer[]
  payDisputes     PayDispute[]
  invites         OrgInvite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// C1: an owner's invitation for someone to join the organization in a role.
/// Held on the server and matched to the email address the person proves
/// they own when they first sign in (never to editable sign-up details).
/// Operational state, not a ledger: resend moves expiresAt, revoke and
/// accept stamp their columns. At most one pending invite per org and email
/// (partial unique index in prisma/c1-roles.sql).
model OrgInvite {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  email        String // lowercased
  role         Role // never WORKER
  invitedById  String       @db.Uuid // Profile.id of the owner who sent it
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?      @db.Uuid // Profile.id created or attached on acceptance
  revokedAt    DateTime?

  @@index([email])
  @@index([orgId, createdAt])
}

/// Versioned, counsel-approved rule profile per jurisdiction.
/// Hard stop: a job may only publish when its jurisdiction profile is the
/// current approved version (enforced in application code, M2).
model JurisdictionProfile {
  id          String   @id @default(uuid()) @db.Uuid
  state       String // e.g. "CO"
  locality    String? // e.g. "Denver" — null means statewide
  version     Int      @default(1)
  isCurrent   Boolean  @default(true)
  approved    Boolean  @default(false)
  approvedAt  DateTime?
  // Versioned by effective date; counsel approval can lapse (spec p.13, p.15).
  effectiveFrom     DateTime? // null = effective immediately
  approvalExpiresAt DateTime? // null = no expiry set by counsel
  // Compensation/eligibility/registration/badge/affidavit/disclosure rules.
  rules       Json
  jobs        Job[]
  createdAt   DateTime @default(now())

  @@unique([state, locality, version])
}

// ---------------------------------------------------------------------------
// Jobs, engagements, shifts
// ---------------------------------------------------------------------------

enum JobType {
  PETITION
  CANVASS
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum CompensationMethod {
  HOURLY // default; always allowed
  SHIFT_RATE // only where the jurisdiction profile allows
  PER_UNIT // only where the jurisdiction profile allows
}

model Job {
  id                String             @id @default(uuid()) @db.Uuid
  orgId             String             @db.Uuid
  org               Organization       @relation(fields: [orgId], references: [id])
  jurisdictionId    String             @db.Uuid
  jurisdiction      JurisdictionProfile @relation(fields: [jurisdictionId], references: [id])
  type              JobType
  title             String
  description       String?
  status            JobStatus          @default(DRAFT)
  startsAt          DateTime?
  endsAt            DateTime?
  geography         Json? // service area / turf boundaries
  compensationMethod CompensationMethod @default(HOURLY)
  payRateCents      Int? // gross rate in cents; worker always sees gross
  headcount         Int?
  hiringMethod      Json? // application / invite / instant-claim config
  requirements      Json? // credentials, training, badges
  // Campaign disclosure (spec p.14): affiliation, issue positions, message.
  // Shapes are defined and validated in src/lib/jobs.ts.
  campaignDisclosure      Json?
  supportContacts         Json? // who handles emergencies, disputes, lost materials
  measureIds              String[] @default([]) // ballot measure / initiative IDs
  cancellationNoticeHours Int      @default(24) // later worker cancellations count as no-shows
  publishedAt             DateTime?
  // Matching weights are versioned on the job (M3); stored when matching ships.
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  engagements      Engagement[]
  conversationJobs ConversationJob[]

  @@index([orgId, status])
  @@index([jurisdictionId])
}

enum EngagementStatus {
  APPLIED
  INVITED
  CLAIMED
  ACTIVE
  COMPLETED
  CANCELLED
  // C3 hiring pipeline: an offer waits on the worker (nothing starts without
  // their accept); declined and withdrawn end an engagement that never began.
  OFFERED
  DECLINED
  WITHDRAWN
}

/// One step in an engagement's hiring history (C3). "In review" is an event,
/// not a status: the worker sees it as a stage while the engagement stays
/// APPLIED.
enum EngagementEventType {
  APPLIED
  CLAIMED
  INVITED
  INVITE_VIEWED
  INVITE_ACCEPTED
  INVITE_DECLINED
  INVITE_WITHDRAWN
  IN_REVIEW
  OFFERED
  OFFER_ACCEPTED
  OFFER_DECLINED
  NOT_SELECTED
  WITHDRAWN
}

/// The dated history of an engagement, shown to the worker and the
/// organization. Append-only (rule 3). No free-text notes about a worker
/// (C3 decision Q5): a structured reason code on NOT_SELECTED, and a note the
/// worker reads.
model EngagementEvent {
  id           String              @id @default(uuid()) @db.Uuid
  engagementId String              @db.Uuid
  engagement   Engagement          @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  type         EngagementEventType
  /// Profile.id of who did it; null only for history filled in by the C3 migration.
  actorId      String?             @db.Uuid
  reasonCode   String? // only on NOT_SELECTED (NOT_SELECTED_REASONS in engagements.ts)
  note         String? // shown to the worker
  createdAt    DateTime            @default(now())

  @@index([engagementId, createdAt])
}

model Engagement {
  id        String           @id @default(uuid()) @db.Uuid
  jobId     String           @db.Uuid
  job       Job              @relation(fields: [jobId], references: [id])
  workerId  String           @db.Uuid
  worker    Worker           @relation(fields: [workerId], references: [id])
  status    EngagementStatus @default(APPLIED)
  // Frozen snapshot of the application + the scorecard shown to the employer
  // at decision time (spec: freeze the employer-facing snapshot).
  applicationSnapshot Json?
  // The org profile who hired this worker (accepted the application, sent
  // the invitation, or created the job for an instant claim). The worker's
  // direct-message thread for this job is with this person.
  hiredById String? @db.Uuid
  hiredBy   Profile? @relation("HiredBy", fields: [hiredById], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  shifts       Shift[]
  payouts      Payout[]
  conversation Conversation?
  events       EngagementEvent[]

  @@unique([jobId, workerId])
  @@index([workerId])
  @@index([hiredById])
}

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Shift {
  id          String      @id @default(uuid()) @db.Uuid
  engagementId String     @db.Uuid
  engagement  Engagement @relation(fields: [engagementId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  status      ShiftStatus @default(SCHEDULED)
  checkInAt   DateTime?
  checkOutAt  DateTime?
  // Field day (M3). Staging point for check-in; the worker's own position is
  // never stored — check-in records only whether they were at staging.
  stagingLocation String?
  stagingLat      Float?
  stagingLng      Float?
  supervisorId    String?  @db.Uuid // Profile.id who accepts custody and reviews
  turfArea        Json? // GeoJSON Polygon of the assigned turf
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  events      WorkEvent[]
  validations Validation[]
  payouts     Payout[]
  payDisputes PayDispute[]

  @@index([engagementId, startsAt])
}

// ---------------------------------------------------------------------------
// Work events (APPEND-ONLY) and validations (APPEND-ONLY)
// ---------------------------------------------------------------------------

enum WorkEventType {
  CHECK_IN
  CHECK_OUT
  PAUSE_START
  PAUSE_END
  DOOR_KNOCK
  CONTACT
  SIGNATURE_SUBMITTED
  CALL
  INTERVIEW
  PACKET_PICKUP // serialized petition packet checked out
  PACKET_RETURN // serialized petition packet returned
  BATCH_COUNT // supervisor batch reconciliation count
  INCIDENT // safety incident / harassment report
  CORRECTION // signed metric correction event (supersedes, never rewrites)
  SHIFT_CANCELLED // payload: { by: "WORKER" | "ORGANIZATION", reason } — append-only record of a cancellation
  NOTE
}

/// Immutable ledger of everything that happened on a shift.
/// NEVER update or delete rows. Corrections are new CORRECTION events.
model WorkEvent {
  id        String        @id @default(uuid()) @db.Uuid
  shiftId   String        @db.Uuid
  shift     Shift         @relation(fields: [shiftId], references: [id])
  type      WorkEventType
  payload   Json // event-specific data (counts, packet IDs, notes, ...)
  actorId   String?       @db.Uuid // Profile.id who recorded it (worker or supervisor); null on pre-M3 rows
  createdAt DateTime      @default(now()) // when it happened (for offline actions: the phone's corrected time)
  // Offline field day (M6): the phone's id for the action, so a re-sent
  // action is saved once; and when an action recorded offline reached the
  // server (null = recorded live).
  clientId   String?   @unique @db.Uuid
  receivedAt DateTime?

  @@index([shiftId, createdAt])
}

enum ValidationStatus {
  APPROVED
  REJECTED
  FLAGGED // anomaly flag for supervisor review
}

/// Supervisor review decisions. APPEND-ONLY: a rejection/appeal is a new row.
model Validation {
  id         String           @id @default(uuid()) @db.Uuid
  shiftId    String           @db.Uuid
  shift      Shift            @relation(fields: [shiftId], references: [id])
  workEventId String?         @db.Uuid
  status     ValidationStatus
  reason     String?
  reviewerId String?          @db.Uuid // Profile.id of the supervisor
  createdAt  DateTime         @default(now())

  payouts Payout[]

  @@index([shiftId])
}

// ---------------------------------------------------------------------------
// Derived metrics (versioned aggregates — computed, never hand-edited)
// ---------------------------------------------------------------------------

/// Scorecard aggregates derived from work_events. Each recompute writes a new
/// row with an incremented version; prior versions are preserved.
model ProfileMetric {
  id         String   @id @default(uuid()) @db.Uuid
  workerId   String   @db.Uuid
  // Versioned aggregates are never erased with the worker (rule 3).
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  version    Int      @default(1)
  // doorsPerActiveHour, contactRate, signaturesPerActiveHour, acceptanceRate,
  // showRate, totals by verification level — see lib/metrics.ts for formulas.
  metrics    Json
  computedAt DateTime @default(now())

  @@unique([workerId, version])
  @@index([workerId])
}

// ---------------------------------------------------------------------------
// Payouts (APPEND-ONLY ledger)
// ---------------------------------------------------------------------------

enum PayoutKind {
  SHIFT // pay for one approved shift
  ADJUSTMENT // a correction to pay (positive or negative), e.g. a resolved dispute
}

enum PayoutEventType {
  APPROVED // finance or the owner approved the line for payment
  HELD // payment put on hold (reason required)
  RELEASED // hold lifted
  VOIDED // the shift was re-reviewed before payment; this line no longer pays
  TRANSFER_STARTED // included in a payout transfer (transferId)
  PAID // the transfer went through (providerRef = Stripe transfer id)
  TRANSFER_FAILED // the provider refused the transfer; the line can be paid again
  REVERSED // a paid transfer was reversed; the line can be paid again or held
}

/// One pay line: what a worker earned for an approved shift, or an
/// adjustment to it. NEVER updated or deleted (database trigger) — status
/// lives in PayoutEvent, and a correction is a new ADJUSTMENT line.
model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  workerId     String       @db.Uuid
  worker       Worker       @relation(fields: [workerId], references: [id])
  orgId        String       @db.Uuid
  org          Organization @relation(fields: [orgId], references: [id])
  engagementId String?      @db.Uuid
  engagement   Engagement?  @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  shiftId      String?      @db.Uuid
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  // The supervisor's approval (closeout) this line pays for.
  validationId String?      @db.Uuid
  validation   Validation?  @relation(fields: [validationId], references: [id], onDelete: Restrict)
  kind         PayoutKind   @default(SHIFT)
  amountCents  Int // gross to the worker (never reduced by a commission); negative only for ADJUSTMENT
  feeCents     Int          @default(0) // platform fee, charged to the organization on top
  // Frozen calculation: method, rate, verified quantity, formula text,
  // jurisdiction version (lib/pay.ts PayBasis). Never recomputed.
  basis        Json?
  adjustsId    String?      @db.Uuid // ADJUSTMENT: the line it corrects
  adjusts      Payout?      @relation("Adjusts", fields: [adjustsId], references: [id], onDelete: Restrict)
  adjustments  Payout[]     @relation("Adjusts")
  createdById  String?      @db.Uuid // Profile: the approving supervisor, or who adjusted
  createdAt    DateTime     @default(now())

  events     PayoutEvent[]
  disputes   PayDispute[]
  resolution PayDisputeResolution?

  @@index([workerId, createdAt])
  @@index([orgId, createdAt])
  @@index([shiftId])
  @@index([engagementId])
  @@index([adjustsId])
}

/// Status history of a pay line. APPEND-ONLY.
model PayoutEvent {
  id          String          @id @default(uuid()) @db.Uuid
  payoutId    String          @db.Uuid
  payout      Payout          @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  type        PayoutEventType
  actorId     String?         @db.Uuid // Profile; null for the provider / system
  reason      String?
  transferId  String?         @db.Uuid
  transfer    PayoutTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  providerRef String? // Stripe transfer id on PAID / REVERSED
  createdAt   DateTime        @default(now())

  @@index([payoutId, createdAt])
  @@index([transferId])
}

/// One payment to one worker covering their approved lines in a pay run.
/// The id is also the Stripe idempotency key and transfer group, so a retry
/// finds or repeats the same transfer instead of paying twice. APPEND-ONLY.
model PayoutTransfer {
  id          String       @id @default(uuid()) @db.Uuid
  workerId    String       @db.Uuid
  worker      Worker       @relation(fields: [workerId], references: [id])
  orgId       String       @db.Uuid
  org         Organization @relation(fields: [orgId], references: [id])
  amountCents Int // sum of the lines' gross pay — what the worker receives
  feeCents    Int // sum of the lines' platform fees (invoiced to the organization)
  destination String // the worker's Stripe account at the time
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())

  events PayoutEvent[]

  @@index([orgId, createdAt])
  @@index([workerId, createdAt])
}

enum DisputeOutcome {
  KEPT // pay stays as it is; the response says why
  ADJUSTED // an ADJUSTMENT line was added
  REREVIEWED // a supervisor re-reviewed the shift after the dispute
}

/// A worker's dispute of a shift's pay (approved or not). APPEND-ONLY;
/// the outcome is a separate row.
model PayDispute {
  id         String       @id @default(uuid()) @db.Uuid
  shiftId    String       @db.Uuid
  shift      Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  workerId   String       @db.Uuid
  worker     Worker       @relation(fields: [workerId], references: [id])
  orgId      String       @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id])
  payoutId   String?      @db.Uuid // the line disputed, when the shift has one
  payout     Payout?      @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  openedById String       @db.Uuid
  reason     String
  createdAt  DateTime     @default(now())

  resolution PayDisputeResolution?

  @@index([orgId, createdAt])
  @@index([shiftId])
  @@index([workerId])
  @@index([payoutId])
}

/// How a dispute was closed. One per dispute. APPEND-ONLY.
model PayDisputeResolution {
  id           String         @id @default(uuid()) @db.Uuid
  disputeId    String         @unique @db.Uuid
  dispute      PayDispute     @relation(fields: [disputeId], references: [id])
  outcome      DisputeOutcome
  response     String
  resolvedById String         @db.Uuid
  adjustmentId String?        @unique @db.Uuid
  adjustment   Payout?        @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
}

/// Stripe webhook events already handled (each is processed once). APPEND-ONLY.
model ProviderEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Audit log (APPEND-ONLY)
// ---------------------------------------------------------------------------

/// Every state change across the five ledger moments: job configured, worker
/// matched, shift executed, work reviewed, payout reconciled.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid // Profile.id, null for system events
  action     String // e.g. "job.published", "shift.completed"
  entityType String // e.g. "Job", "Shift", "Payout"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// M4 — in-app messaging. Access is decided in src/lib/chat.ts (server) and,
// for Supabase Realtime, by RLS policies in prisma/m4-migration.sql.
// Messages are immutable; edits and deletes are MessageRevision rows.
// ---------------------------------------------------------------------------

enum ConversationKind {
  DIRECT // worker ↔ the person who hired them, one per engagement
  GROUP // team chat created by an organizer
}

enum ParticipantRole {
  WORKER
  MANAGER
}

enum RevisionKind {
  EDIT
  DELETE
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  kind          ConversationKind
  orgId         String           @db.Uuid
  org           Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  engagementId  String?          @unique @db.Uuid // DIRECT: exactly one thread per (worker, job)
  engagement    Engagement?      @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  name          String? // GROUP: "Denver housing initiative — Team A"
  createdById   String           @db.Uuid // Profile
  lastMessageAt DateTime? // thread-list ordering; only moves forward
  createdAt     DateTime         @default(now())

  participants ConversationParticipant[]
  jobs         ConversationJob[]
  messages     Message[]

  @@index([orgId, kind])
}

/// GROUP ↔ related jobs: a worker may post only while hired on one of them.
model ConversationJob {
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  jobId          String       @db.Uuid
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([conversationId, jobId])
  @@index([jobId])
}

model ConversationParticipant {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @db.Uuid
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  profileId      String          @db.Uuid
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Restrict)
  role           ParticipantRole
  addedById      String          @db.Uuid
  addedAt        DateTime        @default(now())
  removedAt      DateTime? // set = read-only; history visible up to this moment
  removedById    String?         @db.Uuid
  lastReadAt     DateTime? // unread = messages after this

  @@unique([conversationId, profileId])
  @@index([profileId])
}

/// Immutable: never updated or deleted. See MessageRevision.
model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId       String       @db.Uuid
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String // ≤ 4,000 characters
  attachmentPath String? // private storage key, never a public URL
  attachmentName String?
  attachmentType String? // MIME type checked from the file's bytes
  attachmentSize Int?
  createdAt      DateTime     @default(now())

  revisions MessageRevision[]
  reports   MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// Append-only edits and soft deletes (tombstones). Latest EDIT wins; any DELETE hides the text.
model MessageRevision {
  id             String       @id @default(uuid()) @db.Uuid
  messageId      String       @db.Uuid
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Restrict)
  conversationId String       @db.Uuid // denormalized for realtime filtering
  kind           RevisionKind
  body           String? // EDIT: the new text; DELETE: null
  actorId        String       @db.Uuid
  createdAt      DateTime     @default(now())

  @@index([messageId, createdAt])
  @@index([conversationId, createdAt])
}

model MessageReport {
  id             String    @id @default(uuid()) @db.Uuid
  messageId      String    @db.Uuid
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Restrict)
  conversationId String    @db.Uuid
  orgId          String    @db.Uuid
  reporterId     String    @db.Uuid
  reason         String // ≤ 500 characters
  bodySnapshot   String // the text when reported; survives later edits/deletes
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?   @db.Uuid

  @@unique([messageId, reporterId]) // one report per person per message
  @@index([orgId, createdAt])
}

/// A worker blocking an employer/manager. Unblocking sets liftedAt; rows stay.
/// Messages sent while a block was active stay hidden from the blocker.
/// One active block per pair (partial unique index in m4-migration.sql).
model ProfileBlock {
  id        String    @id @default(uuid()) @db.Uuid
  blockerId String    @db.Uuid
  blocker   Profile   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blockedId String    @db.Uuid
  blocked   Profile   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  liftedAt  DateTime?

  @@index([blockedId])
}

/// Rate-limit counts (src/lib/rate-limit.ts), shared by every server
/// instance: one row per bucket ("login:203.0.113.9") per fixed window.
/// Times are epoch milliseconds. Operational state, not a ledger: rows are
/// deleted once expiresAt passes. Server-only (RLS on, no policies).
model RateLimitCounter {
  bucket      String
  windowStart BigInt
  count       Int
  expiresAt   BigInt

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// C2: what each organization sees. All three tables are APPEND-ONLY: a change
// appends a version (or a superseding row) and the latest wins (rule 3).
// Server-only (RLS on, no policies).
// ---------------------------------------------------------------------------

/// Who may see one part of a worker's profile (C2).
enum ShareAudience {
  RELATIONSHIP // organizations the worker applied to or accepted an invitation from
  ANY_APPROVED_ORG // any organization Turfcut approved that could hire them (takes effect with Matches, C3)
  NOBODY
}

enum CredentialKind {
  CIRCULATOR_REGISTRATION
  NOTARY_OR_AFFIDAVIT
  TRAINING
  OTHER
}

/// The worker's sharing choices, one version per save. No row = the defaults
/// in src/lib/sharing.ts (RELATIONSHIP for every part, not findable).
model WorkerSharing {
  id                   String        @id @default(uuid()) @db.Uuid
  workerId             String        @db.Uuid
  worker               Worker        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  version              Int
  outputAudience       ShareAudience // doors and signatures per hour, doors per shift
  qualityAudience      ShareAudience // signature acceptance, contact rate
  reliabilityAudience  ShareAudience // show rate
  historyAudience      ShareAudience // verified shifts, hours, campaigns, states, dates, totals
  availabilityAudience ShareAudience
  credentialsAudience  ShareAudience
  readReceipts         Boolean       @default(false) // used from C3
  // Findability: off by default. The home area is what the worker typed (a
  // city or ZIP), never a location from the phone.
  findable             Boolean       @default(false)
  workTypes            JobType[]     @default([])
  homeArea             String?
  travelMiles          Int?
  consentTextVersion   String
  actorId              String        @db.Uuid // Profile.id who saved it
  createdAt            DateTime      @default(now())

  // Unique so two concurrent saves can't both claim version N+1.
  @@unique([workerId, version])
}

/// The worker's usual week and date exceptions, one version per save.
/// Never scored or ranked. Shapes are validated in src/lib/availability.ts.
model WorkerAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  workerId   String   @db.Uuid
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  version    Int
  weekly     Json // per weekday, up to two { from: "09:00", to: "15:00" } ranges
  exceptions Json // [{ date: "2026-10-12", ranges: [] }] (no ranges = not available that day)
  note       String?
  actorId    String   @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([workerId, version])
}

/// A credential the worker holds. An edit appends a row that supersedes the
/// previous one; taking one down appends a row with removed = true. The
/// current credentials are the rows nothing supersedes that aren't removed.
model WorkerCredential {
  id           String            @id @default(uuid()) @db.Uuid
  workerId     String            @db.Uuid
  worker       Worker            @relation(fields: [workerId], references: [id], onDelete: Restrict)
  kind         CredentialKind
  label        String? // the worker's name for an OTHER credential or a training course
  state        String? // two-letter state, when the credential has one
  identifier   String? // only the last 4 characters of what the worker typed (credentials.ts), shown masked
  issuedOn     DateTime?         @db.Date
  expiresOn    DateTime?         @db.Date
  verification VerificationLevel @default(SELF_REPORTED)
  verifiedById String?           @db.Uuid
  verifiedAt   DateTime?
  proofPath    String? // unused: proof photos (C3) get their own table; see README "Credential proof photos"
  // Unique: two edits racing on one row can't both supersede it.
  supersedesId String?           @unique @db.Uuid
  supersedes   WorkerCredential? @relation("Supersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy WorkerCredential? @relation("Supersedes")
  removed      Boolean           @default(false)
  actorId      String            @db.Uuid
  createdAt    DateTime          @default(now())

  @@index([workerId, createdAt])
}
